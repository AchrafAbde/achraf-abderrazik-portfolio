# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# ---------------------------------------------------------------------------
# Canonical URL used for SEO metadata, sitemap and structured data.
# Leave empty on Vercel until you add a custom domain (the production
# *.vercel.app URL is detected automatically). Example: https://yourname.dev
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Contact form — option 1 (recommended): forward inquiries to a webhook,
# e.g. an n8n "Webhook" node that routes them to your inbox, CRM or Slack.
# The optional secret is sent in the `x-webhook-secret` header.
# ---------------------------------------------------------------------------
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Contact form — option 2: send inquiries by email with Resend (resend.com).
# CONTACT_TO_EMAIL defaults to the email set in src/content/site.ts.
# CONTACT_FROM_EMAIL must use a domain verified in Resend.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
