# Every variable the site reads, with no values. Never commit real values:
# - Local development: copy this file to .env.local (git-ignored) if needed.
# - Production (Netlify, deployed from GitHub): the public site URL is set in
#   netlify.toml; secrets go in Netlify → Project configuration →
#   Environment variables.

# ---------------------------------------------------------------------------
# The public production URL: canonical URLs, hreflang, sitemap, robots.txt,
# share images and structured data. Read at build time.
# Production: set in netlify.toml (https://achraf-abderrazik.online, the
# primary domain); change it there if the primary domain changes.
# Local development: leave empty to use the fallback, http://localhost:3000.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Contact form — option 1: forward inquiries to a webhook, e.g. an n8n
# "Webhook" node that routes them to your inbox, CRM or Slack. When set, it
# is used instead of Resend. The optional secret is sent in the
# `x-webhook-secret` header.
# ---------------------------------------------------------------------------
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Contact form — option 2: send inquiries by email with Resend (resend.com).
# RESEND_API_KEY is set in Netlify's environment variables.
# CONTACT_TO_EMAIL defaults to the email set in src/content/site.ts.
# CONTACT_FROM_EMAIL must use a domain verified in Resend. Until you have
# one, leave it empty: inquiries are then sent from Resend's test address
# (onboarding@resend.dev), which only delivers to your Resend account's email.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
